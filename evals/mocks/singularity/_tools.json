    {
      "name": "task_list_today",
      "title": "List today tasks",
      "description": "List open tasks scheduled for today in the user’s timezone. Requires a `timezone` argument (IANA name like \"Europe/Moscow\" or offset in minutes like -180).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of items to return."
          },
          "fields": {
            "type": "string",
            "description": "Sparse fields selector."
          },
          "timezone": {
            "oneOf": [
              {
                "type": "string",
                "description": "IANA timezone name (e.g. \"Europe/Moscow\"). Daylight saving is honored automatically."
              },
              {
                "type": "integer",
                "minimum": -720,
                "maximum": 840,
                "description": "Static UTC offset in minutes (e.g. -180 for Moscow). Does not account for DST."
              }
            ],
            "description": "Timezone used to compute the \"today\" day boundaries. IANA string (DST-aware) or integer offset in minutes."
          }
        },
        "additionalProperties": false,
        "required": [
          "timezone"
        ]
      },
